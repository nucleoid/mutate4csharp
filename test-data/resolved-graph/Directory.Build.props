<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><UseSharedCompilation>false</UseSharedCompilation>
    <DefineConstants>$(DefineConstants);INHERITED_GRAPH</DefineConstants>
  </PropertyGroup>
</Project>