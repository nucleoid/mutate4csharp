{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutate4csharp.dev/contracts/check-config-v1.schema.json",
  "title": "mutate4csharp strict check configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projects", "testSuites"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project", "targetFramework", "parseContext", "sources", "testSuites"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "project": { "$ref": "#/$defs/projectPath" },
          "targetFramework": { "$ref": "#/$defs/net10Framework" },
          "parseContext": { "type": "string", "minLength": 1, "maxLength": 256,
            "pattern": "^(?![\\s\\uFEFF])(?![\\s\\S]*[\\s\\uFEFF]$)[^\\u0000-\\u001F\\u007F-\\u009F]+$" },
          "languageVersion": { "const": "14.0" },
          "nullable": { "enum": ["enable", "disable", "annotations", "warnings"] },
          "defineConstants": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
          },
          "sources": { "$ref": "#/$defs/nonEmptyPaths" },
          "testSuites": { "$ref": "#/$defs/nonEmptyIds" }
        }
      }
    },
    "testSuites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "runner", "framework", "configuration", "expectedMembers"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "$ref": "#/$defs/suitePath" },
          "runner": { "const": "vstest" },
          "framework": { "$ref": "#/$defs/net10Framework" },
          "configuration": { "type": "string", "minLength": 1, "maxLength": 128,
            "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "expectedMembers": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "description": "Member names must also be unique case-insensitively; this runtime rule cannot be expressed by JSON Schema uniqueItems.",
            "items": { "type": "string", "minLength": 1, "maxLength": 256,
              "pattern": "^(?!\\.{1,2}$)(?![\\s\\uFEFF])(?![\\s\\S]*[\\s\\uFEFF]$)[^/\\\\\\u0000-\\u001F\\u007F-\\u009F]+$" }
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 512,
            "pattern": "^(?![\\s\\uFEFF])(?![\\s\\S]*[\\s\\uFEFF]$)[^\\u0000-\\u001F\\u007F-\\u009F]+$" }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "mutationCap": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "baselineTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "mutantTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "overallDeadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "allowNotApplicable": { "type": "boolean" },
        "stabilityRepetitions": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*\\\\)(?![\\s\\S]*[\\s\\uFEFF]$)(?![\\s\\uFEFF])(?![\\s\\S]*[\\u0000-\\u001F\\u007F-\\u009F])(?![\\s\\S]*\\/$)[\\s\\S]+$" },
    "projectPath": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.[cC][sS][pP][rR][oO][jJ]$" }] },
    "suitePath": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.(?:[cC][sS][pP][rR][oO][jJ]|[sS][lL][nN]|[sS][lL][nN][xX])$" }] },
    "net10Framework": { "type": "string", "maxLength": 128, "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F])net10\\.0(?:-[a-z0-9.]+)?$" },
    "nonEmptyPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "nonEmptyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
